{
  "pattern": "**/*",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.expo/**",
    "**/generated/**",
    "**/*.gen.*",
    "**/vendor/**",
    "**/docs/**",
    "**/mnt/**",
    "**/android/**",
    "**/ios/**",
    "**/packages/react-native-terminal/rust/**",
    "**/package.json",
    "**/*.md",
    "**/.github/**",
    "**/.claude/**",
    "**/.agents/**",
    "**/*.svg",
    ".external/**",
    "bun.lock"
  ],
  "threshold": 0,
  "minTokens": 50,
  "minLines": 33,
  "maxLines": 1000,
  "maxSize": "100kb"
}
