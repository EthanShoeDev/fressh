{
  "name": "fressh",
  "version": "workspace:*",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@changesets/changelog-github": "^1.0.1",
      "@changesets/cli": "^3.0.3",
      "@effect/atom-react": "4.1.1",
      "@effect/language-service": "^0.87.5",
      "@effect/platform-bun": "4.1.1",
      "@effect/tsgo": "0.63.0",
      "@expo-google-fonts/archivo": "^0.4.2",
      "@expo-google-fonts/inter-tight": "^0.4.2",
      "@expo-google-fonts/jetbrains-mono": "^0.4.1",
      "@expo-google-fonts/space-grotesk": "^0.4.1",
      "@expo-google-fonts/space-mono": "^0.4.2",
      "@expo/ui": "~58.0.26",
      "@expo/vector-icons": "^15.1.1",
      "@fontsource-variable/geist": "^5.3.0",
      "@react-native/metro-config": "0.88.1",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-router": "^1.170.46",
      "@tanstack/react-start": "^1.169.4",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vercel/analytics": "^2.0.1",
      "@vitejs/plugin-react": "^6.1.2",
      "bun-types": "^1.4.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "date-fns": "^4.4.0",
      "effect": "4.1.1",
      "expo": "~58.0.22",
      "expo-build-properties": "~58.0.12",
      "expo-clipboard": "~58.0.4",
      "expo-constants": "~58.0.14",
      "expo-crypto": "~58.0.7",
      "expo-dev-client": "~58.0.18",
      "expo-document-picker": "~58.0.4",
      "expo-font": "~58.0.11",
      "expo-glass-effect": "~58.0.5",
      "expo-image": "~58.0.18",
      "expo-linking": "~58.0.15",
      "expo-router": "~58.0.29",
      "expo-splash-screen": "~58.0.12",
      "expo-symbols": "~58.0.4",
      "expo-system-ui": "~58.0.7",
      "jscpd": "^5.4.2",
      "knip": "^6.44.1",
      "nitro": "3.0.261029-rc",
      "nitrogen": "0.37.1",
      "oxfmt": "0.75.0",
      "oxlint": "1.90.0",
      "oxlint-tsgolint": "7.0.2005",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-native": "0.88.1",
      "react-native-effects": "^0.3.0",
      "react-native-gesture-handler": "~3.3.0",
      "react-native-keyboard-controller": "1.22.7",
      "react-native-keychain": "10.0.0",
      "react-native-mmkv": "4.3.2",
      "react-native-nitro-modules": "0.37.1",
      "react-native-reanimated": "4.7.1",
      "react-native-safe-area-context": "~5.10.1",
      "react-native-screens": "~4.30.1",
      "react-native-web": "~0.21.4",
      "react-native-webgpu": "0.19.2",
      "react-native-worklets": "0.13.0",
      "shadcn": "^4.23.0",
      "shoemaker": "^0.2.3",
      "shoemaker-knip-config": "^0.2.3",
      "shoemaker-oxfmt-config": "^0.2.3",
      "shoemaker-oxlint-config": "^0.2.3",
      "shoemaker-typescript-config": "^0.2.3",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "turbo": "^2.11.10",
      "tw-animate-css": "^1.4.0",
      "typescript": "^7.0.2",
      "uniwind": "^1.13.1",
      "vite": "^8.3.5",
      "vite-tsconfig-paths": "^6.1.1",
      "vitest": "^5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo",
    "oxlint:check": "oxlint -c oxlint.config.ts *.ts scripts",
    "oxlint:fix": "oxlint -c oxlint.config.ts --fix *.ts scripts",
    "oxlint:unsafe:fix": "oxlint -c oxlint.config.ts --fix-dangerously .",
    "oxfmt:check": "oxfmt -c oxfmt.config.ts --check .",
    "oxfmt:fix": "oxfmt -c oxfmt.config.ts --write .",
    "jscpd:check": "jscpd --config .jscpd.json",
    "knip:check": "knip --no-config-hints --cache",
    "knip:fix:danger": "knip --fix --no-config-hints --cache",
    "lint-ignores:report": "shoemaker check lint-ignores",
    "catalog:check": "shoemaker check catalog",
    "catalog:fix": "shoemaker check catalog --fix",
    "effect-versions:check": "shoemaker check effect-versions",
    "nix:fmt:check": "shoemaker check nix-fmt",
    "nix:fmt:fix": "shoemaker check nix-fmt --fix",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "changeset:tag": "changeset tag",
    "//release": "Publish non-private, newly-versioned packages to npm + tag. The terminal pkg's CI publish uses `npm publish --provenance` in release-npm.yml for OIDC provenance; this is the local/manual lever and changesets fallback.",
    "release": "changeset publish",
    "//snapshot": "Canary (snapshot) release: ephemeral 0.0.0-canary-<commit> on the `canary` dist-tag. CI publishes via npm --provenance; these are the local no-provenance equivalents. Run on a throwaway branch — never commit the bump.",
    "version:snapshot": "changeset version --snapshot canary",
    "publish:snapshot": "changeset publish --snapshot --tag canary --no-git-tag",
    "//pre": "Prerelease (rc) mode — ONLY on a dedicated non-default branch; never let .changeset/pre.json reach main.",
    "pre:enter": "changeset pre enter rc",
    "pre:exit": "changeset pre exit",
    "update:all": "nlx taze major -r -I",
    "update:all:2": "nlx npm-check-updates --interactive --format group -ws --root",
    "update:all:3": "bun update -i",
    "update:nix-flake": "nix flake update"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shoemaker": "catalog:",
    "shoemaker-knip-config": "catalog:",
    "shoemaker-oxfmt-config": "catalog:",
    "shoemaker-oxlint-config": "catalog:",
    "shoemaker-typescript-config": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "metro": "0.87.1",
    "metro-babel-transformer": "0.87.1",
    "metro-cache": "0.87.1",
    "metro-cache-key": "0.87.1",
    "metro-config": "0.87.1",
    "metro-core": "0.87.1",
    "metro-file-map": "0.87.1",
    "metro-minify-terser": "0.87.1",
    "metro-resolver": "0.87.1",
    "metro-runtime": "0.87.1",
    "metro-source-map": "0.87.1",
    "metro-symbolicate": "0.87.1",
    "metro-transform-plugins": "0.87.1",
    "metro-transform-worker": "0.87.1",
    "react-native-nitro-modules": "0.37.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "//devEngines": "onFail: warn, not error: release-npm.yml publishes @fressh/react-native-terminal with `npm publish` (OIDC provenance), and npm enforces the workspace root's devEngines, so `error` would block the release.",
  "//overrides": "Metro family pinned to the exact version @expo/metro uses, so one metro exists and the worklets Bundle Mode patches (docs/bun-patches.md) apply to the copy Expo runs; RN's packages ask for ^0.87.1. react-native-nitro-modules: one copy for the app and the terminal package.",
  "patchedDependencies": {
    "metro@0.87.1": "patches/metro@0.87.1.patch",
    "metro-runtime@0.87.1": "patches/metro-runtime@0.87.1.patch",
    "react-native-webgpu@0.19.2": "patches/react-native-webgpu@0.19.2.patch"
  }
}
