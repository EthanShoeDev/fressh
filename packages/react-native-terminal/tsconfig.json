{
  "extends": "shoemaker-typescript-config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "types": ["node"],
    "rootDir": ".",
    "paths": {
      "@fressh/react-native-terminal": ["./src/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noImplicitReturns": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "nitro/**/*.ts"]
}
